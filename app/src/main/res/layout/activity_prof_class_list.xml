<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:id="@+id/classroom_lists"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/content_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ListView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="570dp"
                android:layout_marginStart="1dp"
                android:layout_below="@id/page_classroom_lists_ek1"
                android:layout_marginTop="20dp"
                android:scrollbars="vertical" />

            <RelativeLayout
                android:id="@+id/page_classroom_lists_ek1"
                android:layout_marginTop="0dp"
                android:layout_marginStart="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/classroom_lists_ek3"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal|center"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/enter_your_scholar_id_color"
                    android:layout_marginLeft="122dp"
                    android:layout_marginTop="71dp"
                    android:layout_width="141dp"
                    android:layout_height="27.8dp"
                    android:text="@string/classroom_lists_ek3_string" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/x_1_ek14"
                android:src="@drawable/x_1_ek14"
                android:contentDescription="x_1_ek14"
                android:layout_marginStart="16dp"
                android:layout_marginTop="64dp"
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
