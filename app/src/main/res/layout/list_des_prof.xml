<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<ScrollView
		android:id="@+id/list_des_prof"
		android:layout_width="wrap_content"
		android:layout_height="match_parent">

		<RelativeLayout
			android:id="@+id/content_container"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content">

			<RelativeLayout
				android:id="@+id/page_list_des_prof_ek1"
				android:layout_marginTop="0dp"
				android:layout_marginStart="0dp"
				android:layout_width="wrap_content"
				android:layout_height="790dp">

				<TextView
					android:id="@+id/teachers"
					android:textStyle="bold"
					android:layout_gravity="center_horizontal|center"
					android:gravity="center"
					android:textSize="20sp"
					android:textColor="@color/enter_your_scholar_id_color"
					android:layout_marginLeft="144dp"
					android:layout_marginTop="71dp"
					android:layout_width="97dp"
					android:layout_height="30dp"
					android:text="@string/teachers_string" />

				<RelativeLayout
					android:id="@+id/frame_140_ek2"
					android:layout_marginTop="211dp"
					android:layout_marginStart="16dp"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content">

					<ListView
						android:id="@+id/listeProf"
						android:layout_width="wrap_content"
						android:layout_height="520dp" />
				</RelativeLayout>

				<RelativeLayout
					android:id="@+id/frame_132_ek2"
					android:layout_marginTop="132dp"
					android:layout_marginStart="16dp"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content">

					<View
						android:id="@+id/_bg__frame_132_ek3"
						android:background="@drawable/_bg__frame_132_ek3_shape"
						android:layout_marginStart="0dp"
						android:layout_marginTop="0dp"
						android:layout_width="343dp"
						android:layout_height="47dp" />

					<TextView
						android:id="@+id/add_new_teacher_ek1"
						android:textSize="16sp"
						android:textColor="@color/button_color"
						android:layout_marginLeft="80dp"
						android:layout_marginTop="14dp"
						android:layout_width="150.6dp"
						android:layout_height="23.6dp"
						android:text="@string/add_new_teacher_ek1_string" />
				</RelativeLayout>
				<com.google.android.material.bottomnavigation.BottomNavigationView
					android:id="@+id/bottom_navigation"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_alignParentBottom="true"
					android:background="@color/white"
					app:menu="@menu/admin_navbar" />
			</RelativeLayout>


		</RelativeLayout>
	</ScrollView>
</RelativeLayout>
