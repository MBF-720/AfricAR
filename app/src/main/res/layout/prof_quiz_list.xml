<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<TextView
		android:id="@+id/quizzes_ek8"
		android:textStyle="bold"
		android:layout_gravity="center_horizontal|center"
		android:gravity="center"
		android:textSize="24sp"
		android:textColor="@color/enter_your_scholar_id_color"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="68dp"
		android:text="Quizzes" />

	<ListView
		android:id="@+id/quiz_list_view"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:layout_below="@id/quizzes_ek8"
		android:layout_marginTop="16dp"
		android:layout_above="@id/relative_layout_container"
		android:divider="@android:color/darker_gray"
		android:dividerHeight="1dp" />

	<RelativeLayout
		android:id="@+id/relative_layout_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_above="@id/bottom_navigation"
		android:layout_margin="16dp">

		<View
			android:id="@+id/_bg__component_1_ek17"
			android:layout_width="match_parent"
			android:layout_height="46dp"
			android:background="@drawable/_bg__component_1_ek17_shape" />

		<TextView
			android:id="@+id/button_ek12"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:textSize="18sp"
			android:textColor="@color/button_color"
			android:text="Add new quiz" />
	</RelativeLayout>

	<com.google.android.material.bottomnavigation.BottomNavigationView
		android:id="@+id/bottom_navigation"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentBottom="true"
		android:background="@color/white"
		app:menu="@menu/prof_navigation_menu" />

</RelativeLayout>
