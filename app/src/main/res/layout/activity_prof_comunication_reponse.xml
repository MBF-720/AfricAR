<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentTop="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/communications"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal|center"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="@color/enter_your_scholar_id_color"
                    android:layout_width="204.4dp"
                    android:layout_height="36.4dp"
                    android:text="@string/communications_string"
                    android:layout_marginLeft="90dp"
                    android:layout_marginTop="30dp" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:layout_marginStart="16dp">

                    <EditText
                        android:id="@+id/et_nom"
                        android:textSize="16sp"
                        android:textColor="@color/label_color"
                        android:layout_width="350dp"
                        android:layout_height="48dp"

                        android:layout_marginTop="80dp"
                        android:hint="   Nom"
                        android:background="@drawable/_bg__medium_ek19_shape"/>

                    <EditText
                        android:id="@+id/et_prenom"
                        android:textSize="16sp"
                        android:textColor="@color/label_color"
                        android:layout_width="350dp"
                        android:layout_height="48dp"
                        android:hint="  Prenom"
                        android:background="@drawable/_bg__medium_ek19_shape"
                        android:layout_below="@id/et_nom"
                        android:layout_marginTop="16dp" />

                    <EditText
                        android:id="@+id/et_titre"
                        android:textSize="16sp"
                        android:textColor="@color/label_color"
                        android:layout_width="350dp"
                        android:layout_height="48dp"
                        android:hint="  Titre"
                        android:background="@drawable/_bg__medium_ek19_shape"
                        android:layout_below="@id/et_prenom"
                        android:layout_marginTop="16dp" />

                    <EditText
                        android:id="@+id/et_description"
                        android:textSize="16sp"
                        android:textColor="@color/label_color"
                        android:layout_width="350dp"
                        android:layout_height="150dp"
                        android:hint="Description"
                        android:background="@drawable/_bg__medium_ek19_shape"
                        android:gravity="top|start"
                        android:scrollbars="vertical"
                        android:inputType="textMultiLine"
                        android:overScrollMode="always"
                        android:padding="10dp"
                        android:layout_below="@id/et_titre"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/Reponse"
                        android:textSize="16sp"
                        android:textColor="@color/label_color"
                        android:layout_width="350dp"
                        android:layout_height="150dp"
                        android:hint="Reponse"
                        android:background="@drawable/_bg__medium_ek19_shape"
                        android:gravity="top|start"
                        android:scrollbars="vertical"
                        android:inputType="textMultiLine"
                        android:overScrollMode="always"
                        android:padding="10dp"
                        android:layout_below="@id/et_description"
                        android:layout_marginTop="16dp" />

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="343dp"
                        android:layout_height="48dp"
                        android:text="Save"
                        android:background="@drawable/_bg__component_1_ek15_shape"
                        android:textColor="@android:color/white"
                        android:layout_below="@id/Reponse"
                        android:layout_marginTop="16dp" />
                </RelativeLayout>
            </RelativeLayout>
        </HorizontalScrollView>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/prof_navigation_menu" />

</RelativeLayout>
