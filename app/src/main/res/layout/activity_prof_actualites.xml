<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout">

    <!-- Main content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/acceille"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/content_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/page_acceille_ek1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/menu_button"
                        android:layout_width="30dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="50dp"
                        android:contentDescription="vector_ek22"
                        android:src="@drawable/vector_ek22"
                        android:onClick="openDrawer" />

                    <View
                        android:id="@+id/_bg__acceille_ek2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/_bg__acceille_ek2_shape" />

                    <RelativeLayout
                        android:id="@+id/search_bar"
                        android:layout_marginTop="125dp"
                        android:layout_marginStart="22dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:id="@+id/mingcute_settings_6_fill"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="305dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <!-- Début de votre ScrollView existant -->
                        <ScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:ignore="ExtraText">

                                <!-- Autres éléments existants... -->

                                <!-- ListView pour afficher les actualités -->
                                <ListView
                                    android:id="@+id/listViewActualites"
                                    android:layout_below="@id/_bg__search_bar_ek1"
                                    android:layout_width="385dp"
                                    android:layout_height="570dp"
                                    android:layout_marginStart="-15dp"
                                    android:scrollbars="vertical"
                                    tools:ignore="NotSibling"
                                    android:divider="@android:color/darker_gray"
                                    android:dividerHeight="1dp" />

                                <!-- Continuation de vos autres éléments... -->

                            </RelativeLayout>
                        </ScrollView>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/foulen_ben_foulen"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@color/_bg__checkbox_ek5_color"
                        android:layout_marginLeft="150dp"
                        android:gravity="center"
                        android:layout_marginTop="50dp"
                        android:layout_width="114.2dp"
                        android:layout_height="48.2dp"
                        android:text="Actualités" />

                    <RelativeLayout
                        android:id="@+id/mingcute_notification_fill"
                        android:layout_marginTop="74dp"
                        android:layout_marginStart="335dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:id="@+id/group_ek2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="0dp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/healthicons_i_exam_multiple_choice"
                        android:layout_marginTop="745dp"
                        android:layout_marginStart="241.33dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <RelativeLayout
                        android:id="@+id/component_2_ek8"
                        android:layout_marginTop="68dp"
                        android:layout_marginStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <RelativeLayout
                        android:id="@+id/group_52"
                        android:layout_marginTop="748dp"
                        android:layout_marginStart="336.5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/_bg__group_52_ek1"
                            android:layout_width="13dp"
                            android:layout_height="730dp"
                            android:layout_marginStart="-337dp"
                            android:layout_marginTop="-748dp"
                            android:background="@drawable/_bg__group_52_ek1_shape" />

                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            app:menu="@menu/prof_navigation_menu" />
    </RelativeLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/prof_actualite_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
